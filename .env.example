# Copy to .env for local development. Never commit real secrets.

# development | production
APP_ENV=development

# Leave unset to generate and persist a key in instance/secret_key.
# In production you may prefer to inject this from your secrets manager.
# SECRET_KEY=

# Defaults to SQLite at instance/openlawoffice.db.
# PostgreSQL: postgresql+psycopg://user:password@host:5432/openlawoffice
# MariaDB:    mysql+pymysql://user:password@host:3306/openlawoffice
# DATABASE_URL=

# Force secure-only cookies (defaults to on when APP_ENV=production).
# SESSION_COOKIE_SECURE=true

# Optional one-time token required on the initial administrator setup screen.
# Set this BEFORE exposing a fresh instance to the internet.
# SETUP_TOKEN=

# Comma-separated hostnames Flask should trust (optional).
# TRUSTED_HOSTS=law.example.com

# Number of trusted reverse proxies setting X-Forwarded-* headers (default 0).
# TRUST_PROXY_HOPS=1

# Directory for sanitized firm logo uploads (default: instance/uploads/firm).
# If changed, point it at a persistent, non-public directory writable by the app.
# FIRM_LOGO_UPLOAD_DIR=/var/lib/openlawoffice/uploads/firm

# Display timezone for timestamps.
# TIMEZONE=America/New_York

# Tunables.
# SESSION_LIFETIME_HOURS=12
# PASSWORD_MIN_LENGTH=12
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
